{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(dir \"d:\\develop\\projects\\agent\\app\")",
      "Bash(dir:*)",
      "Bash(test:*)",
      "Bash(pnpm dlx:*)",
      "Bash(del \"d:\\develop\\projects\\agent\\src\\shared\\utils\\cx.ts\")",
      "Bash(pnpm type-check:*)",
      "Bash(git -C \"d:\\develop\\projects\\agent\" log --oneline -10)",
      "Bash(del \"d:\\develop\\projects\\agent\\src\\features\\sidebar\\components\\profile\\UserMenu.tsx\")",
      "Bash(del \"d:\\develop\\projects\\agent\\src\\features\\sidebar\\components\\profile\\GuestMenu.tsx\")",
      "Bash(del \"d:\\develop\\projects\\agent\\src\\features\\sidebar\\components\\profile\\ProfileSection.tsx\")",
      "Bash(find:*)"
    ],
    "deny": [],
    "ask": []
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["shadcn"],
  "outputStyle": "default",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"[console]::beep(1000,300)\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"[console]::beep(1200,200)\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$raw=[Console]::In.ReadToEnd(); try{$j=$raw|ConvertFrom-Json}catch{$j=$null}; if($j -and ($j.notification_type -eq 'permission_prompt' -or $j.notification_type -eq 'idle_prompt')){[console]::beep(880,250)}\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"[console]::beep(700,120)\""
          }
        ]
      }
    ]
  }
}
